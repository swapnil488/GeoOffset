# Copy to .env — never commit .env
# Deployer key (testnet only). Also used as the oracle unless ORACLE_ADDRESS is set.
PRIVATE_KEY=

POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional: separate oracle (Layer 2 relay) address
ORACLE_ADDRESS=
# Optional: use an existing ERC-20 for bonds/stakes instead of deploying MockGeoToken
STAKE_TOKEN_ADDRESS=
CREDITS_BASE_URI=https://geooffset.example/credits/{id}.json

# Relay
LAYER2_URL=http://localhost:8000
